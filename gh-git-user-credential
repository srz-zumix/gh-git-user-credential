#!/usr/bin/env bash
set -euo pipefail

GH_BIN="${GH_BIN:-$(command -v gh || true)}"
if [[ -z "$GH_BIN" ]]; then
  candidates=()
  case "$OSTYPE" in
    darwin*)
      candidates=(/opt/homebrew/bin/gh /usr/local/bin/gh /usr/bin/gh)
      ;;
    msys*|cygwin*)
      for directory in "${PROGRAMFILES:-${ProgramFiles:-}}" "${ProgramW6432:-}"; do
        if [[ -n "$directory" ]]; then
          candidates+=("$directory/GitHub CLI/gh.exe")
        fi
      done
      if [[ -n "${LOCALAPPDATA:-}" ]]; then
        candidates+=("$LOCALAPPDATA/Microsoft/WinGet/Links/gh.exe")
      fi
      if [[ -n "${ChocolateyInstall:-}" ]]; then
        candidates+=("$ChocolateyInstall/bin/gh.exe")
      fi
      if [[ -n "${SCOOP:-}" ]]; then
        candidates+=("$SCOOP/apps/gh/current/bin/gh.exe")
      fi
      if [[ -n "${HOME:-}" ]]; then
        candidates+=("$HOME/scoop/apps/gh/current/bin/gh.exe")
      fi
      candidates+=(
        '/c/Program Files/GitHub CLI/gh.exe'
        '/c/Program Files (x86)/GitHub CLI/gh.exe'
        /c/ProgramData/chocolatey/bin/gh.exe
      )
      ;;
    *)
      candidates=(/usr/local/bin/gh /usr/bin/gh /bin/gh /snap/bin/gh /home/linuxbrew/.linuxbrew/bin/gh)
      ;;
  esac
  if [[ -n "${HOME:-}" ]]; then
    candidates+=("$HOME/.local/bin/gh" "$HOME/bin/gh")
  fi
  for candidate in "${candidates[@]}"; do
    case "$OSTYPE" in
      msys*|cygwin*)
        if command -v cygpath > /dev/null 2>&1; then
          candidate=$(cygpath -u "$candidate")
        fi
        ;;
    esac
    if [[ -x "$candidate" ]]; then
      GH_BIN="$candidate"
      break
    fi
  done
fi

case "$OSTYPE" in
  msys*|cygwin*)
    if [[ -n "$GH_BIN" ]] && command -v cygpath > /dev/null 2>&1; then
      GH_BIN=$(cygpath -u "$GH_BIN")
    fi
    ;;
esac

if [[ -z "$GH_BIN" || ! -x "$GH_BIN" ]]; then
  printf '%s\n' 'GitHub CLI not found. Set GH_BIN to the absolute path of gh.' >&2
  exit 1
fi

GIT_USER=$(git config user.name)

if token=$("$GH_BIN" auth token -h github.com -u "$GIT_USER" 2>/dev/null); then
  export GH_TOKEN="$token"
fi

if [[ "${GH_HOST:-}" != "github.com" ]]; then
  if token=$("$GH_BIN" auth token -u "$GIT_USER" 2>/dev/null); then
    export GH_ENTERPRISE_TOKEN="$token"
  fi
fi

"$GH_BIN" auth git-credential "$@"
